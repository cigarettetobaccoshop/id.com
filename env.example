# R2 NUSANTARA — Environment Template
NEXT_PUBLIC_SUPABASE_URL=https://zgsbtexngystdmakqjyi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY

# OAuth providers are configured in Supabase Dashboard.
# Do NOT put provider client secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=true

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=R2 Nusantara
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_MAX_FILE_SIZE=52428800

# Email Configuration (if using Supabase Email)
SMTP_HOST=smtp.supabase.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# Storage Configuration
NEXT_PUBLIC_STORAGE_BUCKET=avatars
NEXT_PUBLIC_STORAGE_PUBLIC_URL=https://zgsbtexngystdmakqjyi.supabase.co/storage/v1/object/public

# Analytics Configuration
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Feature Flags
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_ENABLE_STORAGE=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Logging
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_LOG_TO_CONSOLE=true
