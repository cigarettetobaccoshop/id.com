# R2 NUSANTARA — Production Environment
NEXT_PUBLIC_SUPABASE_URL=https://zgsbtexngystdmakqjyi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=https://r2nusantara-shop.vercel.app
NEXT_PUBLIC_OAUTH_REDIRECT_URL=https://r2nusantara-shop.vercel.app/auth/callback
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=true
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=R2 Nusantara

# Server-only secret required by /api/orders
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional WhatsApp server integrations
WHATSAPP_BUSINESS_PHONE=REPLACE_WITH_BUSINESS_PHONE
WHATSAPP_CLOUD_ACCESS_TOKEN=REPLACE_WITH_SERVER_ONLY_CLOUD_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
WHATSAPP_GRAPH_VERSION=v23.0

# IMPORTANT:
# Never put Google/GitHub Client Secret in NEXT_PUBLIC_* variables.
# OAuth provider Client ID/Secret are configured in Supabase Dashboard.
